# Copia este fichero a `.env` y rellena los valores necesarios.
# Puedes incluir varias claves separadas por comas para balancear uso.

GOOGLE_MAPS_API_KEYS=clave_google_1,clave_google_2
BING_MAPS_API_KEYS=clave_bing_1,clave_bing_2
OPENAI_API_KEYS=clave_openai_1
PERPLEXITY_API_KEYS=clave_perplexity_1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
PERPLEXITY_DEFAULT_MODEL=sonar-small-chat
OUTPUT_ROOT=clientes
# Si dispones de un servicio Catastro compatible, indica la URL base y token.
CATASTRO_BASE_URL=
CATASTRO_API_TOKEN=
